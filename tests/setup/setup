export STUB_COMPARTMENT_ID="compartmentStub"
export STUB_X86_IMAGE="x86ImageStub"
export STUB_ARM_IMAGE="armImageStub"

bats_require_minimum_version 1.5.0

setup_oci() {
	export OCI_CAPI=true
	run -0 yq -e .compartment "$INFO"
	export CAPI_RESOURCES="$TEST_DIR_CURRENT/$(yq .clusterDefinition "$CLUSTER_CONFIG")"
	export PARENT="$output"
	export CHILD="$CASE_NAME"
	echo Parent compartment is "$PARENT"
	echo New compartment is "$CHILD"

	run -0 yq -e .providers.oci.imageBucket "$CLUSTER_CONFIG"
	export BUCKET="$output"
	echo Bucket is "$BUCKET"

	run -0 oci-make-compartment-under.sh "$PARENT" "$CHILD" "Cluster API Tests"
	export COMPARTMENT_ID=$(printf "$output" | tail -1)
	echo Compartment ID is "$COMPARTMENT_ID"

	sed -i -e "s/${STUB_COMPARTMENT_ID}/${COMPARTMENT_ID}/g" "$CAPI_RESOURCES"

	run oci os bucket get --name "$BUCKET"
	run grep "BucketNotFound" <(printf "$output")
	if [ -n "$output" ]; then
		echo oci os bucket create --compartment-id "$COMPARTMENT_ID" --name "$BUCKET"
		oci os bucket create --compartment-id "$COMPARTMENT_ID" --name "$BUCKET"
	fi

	export X86_IMAGE=
	export ARM_IMAGE=
	run -0 yq -e .preuploadImages "$INFO"
	if [ -n "$output" ]; then
		export X86_IMAGE_ORIG="$STUB_X86_IMAGE"
		export ARM_IMAGE_ORIG="$STUB_ARM_IMAGE"

		run grep -e "$X86_IMAGE_ORIG" "$CAPI_RESOURCES"
		if [ "$status" -eq 0 ]; then
			ocne image create --arch amd64 --version "$KUBE_VERSION"
			run -0 ocne image upload --arch amd64 --version "$KUBE_VERSION" --compartment "$COMPARTMENT_ID" --bucket "$BUCKET" --file "~/.ocne/images/boot.qcow2-$KUBE_VERSION-amd64.oci"
			echo "$output"
			run -0 grep --only-matching -e 'ocid1.image.[a-zA-Z0-9.]*' <(echo "$output")
			export X86_IMAGE="$output"
			echo amd64 image id is "$X86_IMAGE"
			echo sed -i -e "s/${X86_IMAGE_ORIG}/${X86_IMAGE}/g" "$CAPI_RESOURCES"
			sed -i -e "s/${X86_IMAGE_ORIG}/${X86_IMAGE}/g" "$CAPI_RESOURCES"
		fi

		run grep -e "$ARM_IMAGE_ORIG" "$CAPI_RESOURCES"
		if [ "$status" -eq 0 ]; then
			ocne image create --arch arm64 --version "$KUBE_VERSION"
			run -0 ocne image upload --arch arm64 --version "$KUBE_VERSION" --compartment "$COMPARTMENT_ID" --bucket "$BUCKET" --file "~/.ocne/images/boot.qcow2-$KUBE_VERSION-arm64.oci"
			run -0 grep --only-matching -e 'ocid1.image.[a-zA-Z0-9.]*' <(echo "$output")
			export ARM_IMAGE="$output"
			echo sed -i -e "s/${ARM_IMAGE_ORIG}/${ARM_IMAGE}/g" "$CAPI_RESOURCES"
			sed -i -e "s/${ARM_IMAGE_ORIG}/${ARM_IMAGE}/g" "$CAPI_RESOURCES"
		fi
	fi

	yq -i ".providers.oci.compartment = \"${COMPARTMENT_ID}\"" "$CLUSTER_CONFIG"

	# If the cluster is self-managed, override the management cluster kubeconfig
	run yq .providers.oci.selfManaged "$CLUSTER_CONFIG"
	if [ "$output" = "true" ]; then
		export MGMT_CLUSTER="$TARGET_KUBECONFIG"
	fi
}

setup_olvm() {
	echo "OLVM setup: preparing a per-test boot disk and VM template"
	export OLVM_ASSET_MANIFEST="$TEST_DIR_CURRENT/olvm-assets.tsv"
	: > "$OLVM_ASSET_MANIFEST"
	echo "OLVM setup: initialized cleanup manifest $OLVM_ASSET_MANIFEST"
	OLVM_KUBE_VERSION=$(yq -r '.kubernetesVersion' "$CLUSTER_CONFIG")
	if [ -z "$OLVM_KUBE_VERSION" ] || [ "$OLVM_KUBE_VERSION" = "null" ]; then
		echo "OLVM setup: kubernetesVersion is required in $CLUSTER_CONFIG" >&2
		return 1
	fi
	olvm_prepare_assets "$OLVM_KUBE_VERSION" "$CLUSTER_CONFIG" || return $?

	export CAPI_RESOURCES="$TEST_DIR_CURRENT/olvm-template.yaml"
	echo "OLVM setup: rendering Cluster API resources to $CAPI_RESOURCES"
	ocne cluster template --provider olvm --config "$CLUSTER_CONFIG" > "$CAPI_RESOURCES"
}

olvm_prepare_assets() {
	local kube_version="$1" asset_config="$2"

	if [ -z "$kube_version" ] || [ "$kube_version" = "null" ]; then
		echo "OLVM setup: a Kubernetes version is required to prepare OLVM assets" >&2
		return 1
	fi
	if [ ! -f "$asset_config" ]; then
		echo "OLVM setup: asset configuration $asset_config does not exist" >&2
		return 1
	fi

	echo "OLVM setup: preparing disk and template for Kubernetes version $kube_version using $asset_config"
	olvm_require_commands || return $?
	export OLVM_KUBE_VERSION="$kube_version"
	olvm_configure_connection "$asset_config" || return $?
	olvm_create_asset_names
	echo "OLVM setup: creating disk $OLVM_DISK_NAME and template $OLVM_TEMPLATE_NAME"
	yq -i '
		.providers.olvm.olvmOCK.diskName = strenv(OLVM_DISK_NAME) |
		.providers.olvm.controlPlaneMachine.vmTemplateName = strenv(OLVM_TEMPLATE_NAME) |
		.providers.olvm.workerMachine.vmTemplateName = strenv(OLVM_TEMPLATE_NAME)
	' "$asset_config"

	export OLVM_IMAGE_PATH="$HOME/.ocne/images/boot.qcow2-$OLVM_KUBE_VERSION-amd64.olvm"
	echo "OLVM setup: creating boot image at $OLVM_IMAGE_PATH"
	ocne image create --type olvm --arch amd64 --config "$asset_config" --kubeconfig "$MGMT_KUBECONFIG"
	if [ ! -s "$OLVM_IMAGE_PATH" ]; then
		echo "OLVM setup: image creation did not produce $OLVM_IMAGE_PATH" >&2
		return 1
	fi
	echo "OLVM setup: uploading boot image to OLVM disk $OLVM_DISK_NAME"
	ocne image upload --type olvm --arch amd64 --config "$asset_config" --file "$OLVM_IMAGE_PATH" --kubeconfig "$MGMT_KUBECONFIG"

	olvm_authenticate
	export OLVM_DISK_ID=$(olvm_get_disk_id)
	if [ -z "$OLVM_DISK_ID" ]; then
		echo "OLVM setup: could not find uploaded disk $OLVM_DISK_NAME" >&2
		return 1
	fi
	echo "OLVM setup: uploaded disk ID is $OLVM_DISK_ID"
	olvm_create_template || return $?
	olvm_record_asset
}

olvm_configure_connection() {
	local asset_config="$1"

	export OLVM_API_URL=$(yq -r '.providers.olvm.olvmOvirtAPIServer.serverURL' "$asset_config")
	export OLVM_OVIRT_CLUSTER=$(yq -r '.providers.olvm.controlPlaneMachine.olvmOvirtClusterName' "$asset_config")
	export OLVM_INSECURE_SKIP_TLS_VERIFY=$(yq -r '.providers.olvm.olvmOvirtAPIServer.insecureSkipTLSVerify' "$asset_config")
	export OLVM_SERVER_CA=$(yq -r '.providers.olvm.olvmOvirtAPIServer.serverCA' "$asset_config")
	export OLVM_CA_PATH=$(yq -r '.providers.olvm.olvmOvirtAPIServer.serverCAPath' "$asset_config")
	if [ -z "$OLVM_API_URL" ] || [ "$OLVM_API_URL" = "null" ] || [ -z "$OLVM_OVIRT_CLUSTER" ] || [ "$OLVM_OVIRT_CLUSTER" = "null" ]; then
		echo "OLVM setup: server URL and oVirt cluster name are required in $asset_config" >&2
		return 1
	fi
	olvm_configure_tls
}

olvm_record_asset() {
	export OLVM_ASSET_MANIFEST="$TEST_DIR_CURRENT/olvm-assets.tsv"
	printf '%s\t%s\t%s\t%s\n' "$OLVM_TEMPLATE_ID" "$OLVM_TEMPLATE_NAME" "$OLVM_DISK_ID" "$OLVM_DISK_NAME" >> "$OLVM_ASSET_MANIFEST"
	echo "OLVM setup: recorded cleanup data for template $OLVM_TEMPLATE_NAME and disk $OLVM_DISK_NAME"
}

olvm_require_commands() {
	local command_name
	for command_name in curl ocne yq; do
		if ! command -v "$command_name" >/dev/null 2>&1; then
			echo "OLVM setup: required command $command_name is not available" >&2
			return 1
		fi
	done
	if [ -z "$OCNE_OLVM_USERNAME" ] || [ -z "$OCNE_OLVM_PASSWORD" ] || [ -z "$OCNE_OLVM_SCOPE" ]; then
		echo "OLVM setup: OCNE_OLVM_USERNAME, OCNE_OLVM_PASSWORD, and OCNE_OLVM_SCOPE are required" >&2
		return 1
	fi
}

olvm_configure_tls() {
	local ca_file trimmed_ca_file
	local -a ca_files

	# The OLVM provider uses a custom Go transport with no proxy configured.
	# Match that connection path so an ambient HTTPS proxy cannot replace the
	# engine certificate chain with the proxy's certificate chain.
	OLVM_CURL_PROXY_ARGS=(--noproxy '*')
	echo "OLVM setup: bypassing ambient proxies to match the OLVM provider transport" >&2

	if [ "$OLVM_INSECURE_SKIP_TLS_VERIFY" = "true" ]; then
		echo "OLVM setup: TLS verification is disabled for OLVM API requests" >&2
		OLVM_CURL_TLS_ARGS=(--insecure)
		return 0
	fi

	if [ "$OLVM_SERVER_CA" != "null" ] && [ -n "$OLVM_SERVER_CA" ] && [ "$OLVM_CA_PATH" != "null" ] && [ -n "$OLVM_CA_PATH" ]; then
		echo "OLVM setup: serverCA and serverCAPath cannot both be configured" >&2
		return 1
	fi

	if [ "$OLVM_SERVER_CA" = "null" ] || [ -z "$OLVM_SERVER_CA" ]; then
		OLVM_SERVER_CA=""
	fi
	if [ "$OLVM_CA_PATH" = "null" ] || [ -z "$OLVM_CA_PATH" ]; then
		OLVM_CA_PATH=""
	fi

	if [ -z "$OLVM_SERVER_CA" ] && [ -z "$OLVM_CA_PATH" ]; then
		echo "OLVM setup: no OLVM CA is configured; using the system trust store" >&2
		OLVM_CURL_TLS_ARGS=()
		return 0
	fi

	export OLVM_CA_CHAIN_PATH=$(mktemp "$TEST_DIR_CURRENT/olvm-ca-chain.XXXXXX") || {
		echo "OLVM setup: could not create a CA-chain file" >&2
		return 1
	}

	if [ -n "$OLVM_SERVER_CA" ]; then
		echo "OLVM setup: building the OLVM CA chain from inline serverCA" >&2
		printf '%s\n' "$OLVM_SERVER_CA" > "$OLVM_CA_CHAIN_PATH"
	else
		IFS=',' read -r -a ca_files <<< "$OLVM_CA_PATH"
		echo "OLVM setup: building the OLVM CA chain from ${#ca_files[@]} serverCAPath file(s)" >&2
		for ca_file in "${ca_files[@]}"; do
			trimmed_ca_file=$(printf '%s' "$ca_file" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')
			if [ ! -r "$trimmed_ca_file" ]; then
				echo "OLVM setup: readable server CA path is required when TLS verification is enabled: $trimmed_ca_file" >&2
				return 1
			fi
			cat "$trimmed_ca_file" >> "$OLVM_CA_CHAIN_PATH"
			printf '\n' >> "$OLVM_CA_CHAIN_PATH"
		done
	fi

	echo "OLVM setup: using the provider-equivalent OLVM CA chain for API requests" >&2
	OLVM_CURL_TLS_ARGS=(--cacert "$OLVM_CA_CHAIN_PATH")
}

olvm_create_asset_names() {
	local raw_name safe_name
	raw_name="${CASE_NAME:-olvm}-${OLVM_KUBE_VERSION}-${BUILD_TAG:-local}-$(date +%s)-$$"
	safe_name=$(printf '%s' "$raw_name" | tr '[:upper:]' '[:lower:]' | tr -cs '[:alnum:]' '-')
	safe_name=${safe_name#-}
	safe_name=${safe_name%-}
	safe_name=$(printf '%s' "$safe_name" | cut -c1-80)
	export OLVM_DISK_NAME="${safe_name}-disk"
	export OLVM_TEMPLATE_NAME="${safe_name}-template"
	export OLVM_TEMP_VM_NAME="${safe_name}-source"
}

olvm_authenticate() {
	local token_response xtrace_state curl_status
	echo "OLVM setup: requesting an OLVM API access token" >&2
	xtrace_state=$(set +o | grep xtrace)
	set +x
	if token_response=$(curl "${OLVM_CURL_PROXY_ARGS[@]}" "${OLVM_CURL_TLS_ARGS[@]}" --silent --show-error --fail --request POST "$OLVM_API_URL/sso/oauth/token" --header 'Accept: application/json' --data-urlencode "username=$OCNE_OLVM_USERNAME" --data-urlencode "password=$OCNE_OLVM_PASSWORD" --data-urlencode "scope=$OCNE_OLVM_SCOPE" --data-urlencode 'grant_type=password'); then
		curl_status=0
	else
		curl_status=$?
	fi
	eval "$xtrace_state"
	if [ "$curl_status" -ne 0 ]; then
		echo "OLVM setup: OLVM API authentication failed" >&2
		return "$curl_status"
	fi
	export OLVM_ACCESS_TOKEN=$(printf '%s' "$token_response" | yq -r '.access_token')
	if [ -z "$OLVM_ACCESS_TOKEN" ] || [ "$OLVM_ACCESS_TOKEN" = "null" ]; then
		echo "OLVM setup: OLVM API token response did not contain access_token" >&2
		return 1
	fi
	echo "OLVM setup: OLVM API authentication completed" >&2
}

olvm_api_request() {
	local method=$1 path=$2 payload=${3:-} response xtrace_state curl_status
	echo "OLVM setup: OLVM API $method $path" >&2
	xtrace_state=$(set +o | grep xtrace)
	set +x
	if [ -n "$payload" ]; then
		if response=$(curl "${OLVM_CURL_PROXY_ARGS[@]}" "${OLVM_CURL_TLS_ARGS[@]}" --silent --show-error --fail --request "$method" "$OLVM_API_URL$path" --header 'Accept: application/json' --header 'Content-Type: application/json' --header "Authorization: Bearer $OLVM_ACCESS_TOKEN" --data "$payload"); then
			curl_status=0
		else
			curl_status=$?
		fi
	else
		if response=$(curl "${OLVM_CURL_PROXY_ARGS[@]}" "${OLVM_CURL_TLS_ARGS[@]}" --silent --show-error --fail --request "$method" "$OLVM_API_URL$path" --header 'Accept: application/json' --header "Authorization: Bearer $OLVM_ACCESS_TOKEN"); then
			curl_status=0
		else
			curl_status=$?
		fi
	fi
	eval "$xtrace_state"
	if [ "$curl_status" -ne 0 ]; then
		echo "OLVM setup: OLVM API request failed: $method $path" >&2
		return "$curl_status"
	fi
	printf '%s' "$response"
}

olvm_get_disk_id() {
	local disks
	disks=$(olvm_api_request GET "/api/disks?search=name%3D$OLVM_DISK_NAME") || return $?
	printf '%s' "$disks" | yq -r '.disk[] | select(.name == strenv(OLVM_DISK_NAME)) | .id' | head -1
}

olvm_create_template() {
	local vm_payload attachment_payload template_payload vm_response attachment_response template_response
	vm_payload=$(yq -n -o=json '.name = strenv(OLVM_TEMP_VM_NAME) | .cluster.name = strenv(OLVM_OVIRT_CLUSTER) | .template.name = "Blank" | .os.type = "ol_cos"')
	echo "OLVM setup: creating stopped source VM $OLVM_TEMP_VM_NAME" >&2
	vm_response=$(olvm_api_request POST '/api/vms' "$vm_payload") || return $?
	export OLVM_TEMP_VM_ID=$(printf '%s' "$vm_response" | yq -r '.id')
	if [ -z "$OLVM_TEMP_VM_ID" ] || [ "$OLVM_TEMP_VM_ID" = "null" ]; then
		echo "OLVM setup: VM creation response did not contain an ID" >&2
		return 1
	fi
	attachment_payload=$(yq -n -o=json '.bootable = true | .active = true | .interface = "virtio" | .disk.id = strenv(OLVM_DISK_ID)')
	echo "OLVM setup: attaching uploaded disk to source VM $OLVM_TEMP_VM_ID" >&2
	attachment_response=$(olvm_api_request POST "/api/vms/$OLVM_TEMP_VM_ID/diskattachments" "$attachment_payload") || return $?
	if [ -z "$attachment_response" ]; then
		echo "OLVM setup: disk attachment returned no response" >&2
		return 1
	fi
	template_payload=$(yq -n -o=json '.name = strenv(OLVM_TEMPLATE_NAME) | .vm.id = strenv(OLVM_TEMP_VM_ID)')
	echo "OLVM setup: creating VM template $OLVM_TEMPLATE_NAME" >&2
	template_response=$(olvm_api_request POST '/api/templates' "$template_payload") || return $?
	export OLVM_TEMPLATE_ID=$(printf '%s' "$template_response" | yq -r '.id')
	if [ -z "$OLVM_TEMPLATE_ID" ] || [ "$OLVM_TEMPLATE_ID" = "null" ]; then
		echo "OLVM setup: template creation response did not contain an ID" >&2
		return 1
	fi
	olvm_wait_for_template
	echo "OLVM setup: deleting temporary source VM $OLVM_TEMP_VM_ID" >&2
	olvm_api_request DELETE "/api/vms/$OLVM_TEMP_VM_ID" >/dev/null
}

olvm_wait_for_template() {
	local attempt=0 template_response template_status
	echo "OLVM setup: waiting for VM template $OLVM_TEMPLATE_ID to become ready" >&2
	while [ "$attempt" -lt 120 ]; do
		template_response=$(olvm_api_request GET "/api/templates/$OLVM_TEMPLATE_ID") || return $?
		template_status=$(printf '%s' "$template_response" | yq -r '.status')
		if [ "$template_status" = "ok" ]; then
			echo "OLVM setup: VM template $OLVM_TEMPLATE_NAME is ready" >&2
			return 0
		fi
		echo "OLVM setup: template status is $template_status; waiting (attempt $((attempt + 1))/120)" >&2
		sleep 5
		attempt=$((attempt + 1))
	done
	echo "OLVM setup: timed out waiting for VM template $OLVM_TEMPLATE_NAME" >&2
	return 1
}

teardown_oci() {
	if [ -n "X86_IMAGE" ]; then
			sed -i -e "s/${X86_IMAGE}/${X86_IMAGE_ORIG}/g" "$CAPI_RESOURCES"
			oci compute image delete --force --image-id "$X86_IMAGE"
	fi
	if [ -n "$ARM_IMAGE" ]; then
			sed -i -e "s/${ARM_IMAGE}/${ARM_IMAGE_ORIG}/g" "$CAPI_RESOURCES"
			oci compute image delete --force --image-id "$ARM_IMAGE"
	fi

	sed -i -e "s/${COMPARTMENT_ID}/${STUB_COMPARTMENT_ID}/g" "$CAPI_RESOURCES"

	if [ -n "$COMPARTMENT_ID" ]; then
		echo oci os bucket delete --bucket-name "$BUCKET"
		echo oci-delete-compartment.sh "$COMPARTMENT_ID"
	fi
}

teardown_olvm() {
	local template_id template_name disk_id disk_name

	export OLVM_ASSET_MANIFEST="$TEST_DIR_CURRENT/olvm-assets.tsv"
	if [ ! -s "$OLVM_ASSET_MANIFEST" ]; then
		echo "OLVM teardown: no complete OLVM asset sets were created"
		return 0
	fi
	olvm_authenticate
	while IFS=$'\t' read -r template_id template_name disk_id disk_name; do
		[ -n "$template_id" ] && [ -n "$disk_id" ] || continue
		export OLVM_TEMPLATE_ID="$template_id"
		export OLVM_TEMPLATE_NAME="$template_name"
		export OLVM_DISK_ID="$disk_id"
		export OLVM_DISK_NAME="$disk_name"
		echo "OLVM teardown: deleting template $OLVM_TEMPLATE_ID"
		olvm_api_request DELETE "/api/templates/$OLVM_TEMPLATE_ID" >/dev/null
		olvm_wait_for_template_deletion || return $?
		echo "OLVM teardown: deleting disk $OLVM_DISK_ID"
		olvm_api_request DELETE "/api/disks/$OLVM_DISK_ID" >/dev/null
	done < "$OLVM_ASSET_MANIFEST"
	echo "OLVM teardown: completed"
}

olvm_wait_for_template_deletion() {
	local attempt=0 templates remaining_template_id
	echo "OLVM teardown: waiting for template $OLVM_TEMPLATE_NAME to be removed" >&2
	while [ "$attempt" -lt 120 ]; do
		templates=$(olvm_api_request GET "/api/templates?search=name%3D$OLVM_TEMPLATE_NAME") || return $?
		remaining_template_id=$(printf '%s' "$templates" | yq -r '.template[] | select(.name == strenv(OLVM_TEMPLATE_NAME)) | .id' | head -1)
		if [ -z "$remaining_template_id" ]; then
			echo "OLVM teardown: template $OLVM_TEMPLATE_NAME has been removed" >&2
			return 0
		fi
		echo "OLVM teardown: template removal is pending (attempt $((attempt + 1))/120)" >&2
		sleep 5
		attempt=$((attempt + 1))
	done
	echo "OLVM teardown: timed out waiting for template $OLVM_TEMPLATE_NAME to be removed" >&2
	return 1
}


setup_capi() {
	export UPDATE_MODE="capi"
	export CAPI_MODE="true"

	run stat "$MGMT_CONFIG"
	if [ "$status" -eq 0 ]; then
		export MGMT_NAME="$CASE_NAME-mgmt"
		ocne cluster start -C "$MGMT_NAME" --auto-start-ui=false -c "$MGMT_CONFIG"
	else
		export MGMT_NAME="$CASE_NAME-mgmt"
		# If there is no management cluster, make one
		ocne cluster start -C "$MGMT_NAME" --auto-start-ui=false
	fi

	run -0 ocne cluster show -C "$MGMT_NAME"
	export MGMT_KUBECONFIG="$output"
	export BOOTSTRAP_KUBECONFIG="$MGMT_KUBECONFIG"

	export KUBECONFIG="$MGMT_KUBECONFIG"

	run yq .generate "$INFO"
	if [ "$output" != "false" ]; then
		case "$PROVIDER" in
		oci ) setup_oci ;;
		olvm ) setup_olvm ;;
		*) echo "$PROVIDER is not a valid provider"; false ;;
		esac
	fi
}

setup_noncapi() {
	export UPDATE_MODE="node"
	export CAPI_MODE="false"
}

resolve_kubernetes_version() {
	unset KUBE_VERSION
	echo "Kubernetes version resolution: checking $CLUSTER_CONFIG"
	run -0 yq -r '.kubernetesVersion // ""' "$CLUSTER_CONFIG"
	if [ "$status" -ne 0 ]; then
		echo "Kubernetes version resolution: could not read $CLUSTER_CONFIG" >&2
		return "$status"
	fi
	if [ -n "$output" ]; then
		export KUBE_VERSION="$output"
		echo "Kubernetes version resolution: using kubernetesVersion from $CLUSTER_CONFIG: $KUBE_VERSION"
		return 0
	fi

	echo "Kubernetes version resolution: kubernetesVersion is not defined in $CLUSTER_CONFIG; checking $INFO"
	run -0 yq -r '.version // ""' "$INFO"
	if [ "$status" -ne 0 ]; then
		echo "Kubernetes version resolution: could not read $INFO" >&2
		return "$status"
	fi
	if [ -n "$output" ]; then
		export KUBE_VERSION="$output"
		echo "Kubernetes version resolution: using version from $INFO: $KUBE_VERSION"
	else
		echo "Kubernetes version resolution: no version is defined; the started cluster will provide the version"
	fi
}

setup_suite() {
	run yq .skip "$INFO"
	if [ "$output" = "true" ]; then
		skip "Test explicitly skipped"
	fi

	resolve_kubernetes_version || return $?

	run -0 yq -e .provider "$INFO"
	export PROVIDER="$output"
	case "$PROVIDER" in
	libvirt | byo ) setup_noncapi ;;
	* ) setup_capi ;;
	esac

	run -0 yq -e .name "$CLUSTER_CONFIG"
	export CLUSTER_NAME="$output"
	echo Cluster name is "$CLUSTER_NAME"

	if [ -f "$START_SCRIPT" ]; then
		sh "$START_SCRIPT"
	else
		ocne cluster start -c "$CLUSTER_CONFIG" --auto-start-ui=false
	fi
	run -0 ocne cluster show -C "$CLUSTER_NAME"
	export KUBECONFIG="$output"
	export TARGET_KUBECONFIG="$KUBECONFIG"

	if [ -z "$KUBE_VERSION" ]; then
		echo "Kubernetes version resolution: reading the version from started cluster $CLUSTER_NAME"
		run -0 ocne cluster show -C "$CLUSTER_NAME" -f config.kubernetesVersion
		export KUBE_VERSION="$output"
	fi
	[ -n "$KUBE_VERSION" ]

	export BATS_TEST_NAME_PREFIX="${BATS_TEST_NAME_PREFIX}${PROVIDER} ${KUBE_VERSION}: "

	# The wait begins before a worker node is ready, which is needed to schedule the coredns pod.
	kubectl wait deployment -n kube-system coredns --for condition=Available=True --timeout=900s
	kubectl wait deployment -n ocne-system ocne-catalog --for condition=Available=True --timeout=600s
}

teardown_noncapi() {
	echo "Nothing to do"
}

teardown_suite() {
	run yq .skip "$INFO"
	if [ "$output" = "true" ]; then
		skip "Test explicitly skipped"
	fi

	unset KUBECONFIG
	if [ -n "$BOOTSTRAP_KUBECONFIG" ]; then
		export MGMT_KUBECONFIG="$BOOTSTRAP_KUBECONFIG"
		export KUBECONFIG="$MGMT_KUBECONFIG"
	fi

	if [ -f "$DELETE_SCRIPT" ]; then
		sh "$DELETE_SCRIPT"
	else
		ocne cluster delete -c "$CLUSTER_CONFIG"
	fi

	if [ -n "$MGMT_KUBECONFIG" ]; then
		unset KUBECONFIG
		run stat "$MGMT_CONFIG"
		if [ "$status" -eq 0 ]; then
			ocne cluster delete -C "$MGMT_NAME" -c "$MGMT_CONFIG"
		else
			ocne cluster delete -C "$MGMT_NAME"
		fi
	fi

	run yq .preserve "$INFO"
	if [ "$output" != "true" ]; then
		case "$PROVIDER" in
		libvirt | byo ) teardown_noncapi ;;
		oci ) teardown_oci ;;
		olvm ) teardown_olvm ;;
		* ) echo "$PROVIDER is not a valid provider"; false ;;
		esac
	fi
}
